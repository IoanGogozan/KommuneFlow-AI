COMPOSE_PROJECT_NAME=kommuneflow-ai

APP_DOMAIN=kommune.example.com
APP_BASE_URL=https://kommune.example.com
API_BASE_URL=https://kommune.example.com/api/v1
CORS_ALLOWED_ORIGINS=https://kommune.example.com

POSTGRES_DB=kommuneflow_ai
POSTGRES_USER=kommuneflow
POSTGRES_PASSWORD=replace-with-long-random-url-safe-password

JWT_SECRET=replace-with-at-least-32-random-bytes
SESSION_SECRET=replace-with-separate-at-least-32-random-bytes
STATUS_CODE_PEPPER=replace-with-separate-long-random-value

DEMO_BASIC_AUTH_USER=replace-with-demo-gate-user
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'strong-password'
DEMO_BASIC_AUTH_HASH='$2a$14$replace-with-caddy-hash'

JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
LOG_LEVEL=info
DEFAULT_LOCALE=nb
SUPPORTED_LOCALES=nb,en

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000

SEED_DEMO_PASSWORD=replace-with-demo-user-password
SEED_RECRUITER_PASSWORD=replace-with-recruiter-user-password
